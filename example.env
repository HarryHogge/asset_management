# Copy to .env and adjust. .env is git-ignored; this file is not.

# SharePoint list export to read (relative paths resolve against this repo).
ASSET_CSV=Asset Tracking V2.csv

# Time zone of the SharePoint site. List dates are stored as local midnight
# in UTC, so this decides which calendar day they land on.
SITE_TIMEZONE=America/Los_Angeles

# Last Inventory older than this many days is flagged as overdue.
INVENTORY_STALE_DAYS=90

# Avoid 5060/5061 (SIP); browsers block them.
PORT=5070

# Where the Fleet Overview keeps its daily readiness numbers for the trend
# chart: one line per day, written by the first good data load of each day.
# Relative paths resolve against this repo; data/ is git-ignored. On PROD,
# put it outside the repo folder so a re-clone keeps the history, for
# example C:\asset_data\readiness_history.jsonl. The folder is created if
# it is missing.
READINESS_HISTORY=data/readiness_history.jsonl

# Where the data comes from: csv (the export named in ASSET_CSV, the default)
# or sharepoint (the live list, read through Microsoft Graph with the
# settings below). Run `python -m sharepoint --check` before switching.
ASSET_SOURCE=csv

# ---------------------------------------------------------------------------
# SharePoint. Only read when ASSET_SOURCE=sharepoint, or by the check command.
# Every SP_ setting except SP_REFRESH_SECONDS is required then, with no
# defaults: if one is missing or wrong, the dashboard keeps running but every
# page names the setting to fix (never its value), and the log says so once
# at startup. Fix it here and restart the dashboard.
# Values come from IT's app registration. Write paths and passwords without
# double quotes: inside double quotes a backslash is read as a special
# character. Use single quotes if a value contains a space, # or a quote.
# ---------------------------------------------------------------------------

# Directory (tenant) ID of the Microsoft 365 tenant.
SP_TENANT_ID=

# Application (client) ID of the app registration.
SP_CLIENT_ID=

# Site ID of the Flight Ops (FLOPS) SharePoint site, as IT gave it
# (it usually looks like host,guid,guid).
SP_SITE_ID=

# The list's name exactly as SharePoint shows it.
SP_LIST_NAME=Asset Tracking V2

# Full path to the certificate (.pfx) file. Keep it OUTSIDE this folder, for
# example C:\certs\asset-dashboard.pfx, so it can never be committed.
SP_CERT_PATH=

# Password for the .pfx file.
SP_CERT_PASSWORD=

# How many seconds a fetched copy of the list is reused before fetching again.
# 300 (5 minutes): people edit the list by hand a few times a day, so a page
# is at most 5 minutes behind, while the dashboard makes only a handful of
# requests to Microsoft every 5 minutes no matter how many people look at it.
# Minimum 30.
SP_REFRESH_SECONDS=300
