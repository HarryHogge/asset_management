.env
.venv/
venv/
__pycache__/
*.pyc

# Raw SharePoint exports contain colleagues' names and emails; keep new ones
# out of git. (Asset Tracking V2.csv was committed before this rule existed.)
exports/
*.xlsx

# The readiness history the dashboard writes (READINESS_HISTORY). It is made
# from list data, so it stays out of git.
data/

# Certificates and keys never go in git. The SharePoint certificate lives
# outside this folder (SP_CERT_PATH); these rules are a second line of defence.
*.pfx
*.p12
*.pem
*.key
*.cer
